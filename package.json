{
  "name": "4-nerds-event-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "test:scanner": "node --experimental-strip-types --test tests/cardScanParsing.test.ts",
    "test:card-search": "node --experimental-strip-types --test tests/pokemonCardSearchCore.test.ts",
    "test:multi-game": "node --experimental-strip-types --experimental-specifier-resolution=node --test tests/unifiedCardSearchCore.test.ts",
    "test:trade": "node --experimental-strip-types --experimental-specifier-resolution=node --test tests/tradeMath.test.ts",
    "test:transactions": "node --experimental-strip-types --experimental-specifier-resolution=node --test tests/transactionMath.test.ts",
    "test:flow": "node --experimental-strip-types --experimental-specifier-resolution=node --test tests/transactionFlowRoutes.test.ts",
    "test:exports": "node --experimental-strip-types --experimental-specifier-resolution=node --test tests/financialExport.test.ts",
    "test:payload": "node --experimental-strip-types --experimental-specifier-resolution=node --test tests/financialTransactionPayload.test.ts",
    "test:pricing": "node --experimental-strip-types --experimental-specifier-resolution=node --test tests/cardPricing.test.ts",
    "test:reliability": "node --experimental-strip-types --experimental-specifier-resolution=node --test tests/transactionReliability.test.ts",
    "test:schedule": "node --experimental-strip-types --import ./tests/typescriptResolveHook.mjs --test tests/shareSchedule.test.ts",
    "test:image-limit": "node --experimental-strip-types --test tests/transactionImageLimit.test.ts",
    "test:deal": "node --experimental-strip-types --import ./tests/typescriptResolveHook.mjs --test tests/dealBuilder.test.ts",
    "test:deal-mobile": "node --experimental-strip-types --test tests/newDealMobileLayout.test.ts",
    "test": "npm run test:scanner && npm run test:card-search && npm run test:multi-game && npm run test:trade && npm run test:transactions && npm run test:flow && npm run test:exports && npm run test:payload && npm run test:pricing && npm run test:reliability && npm run test:schedule && npm run test:image-limit && npm run test:deal && npm run test:deal-mobile",
    "preview": "vite preview --host 0.0.0.0",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.2",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.2",
    "@capacitor/preferences": "^7.0.2",
    "@supabase/supabase-js": "^2.106.2",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "^1.2.0",
    "chrono-node": "^2.9.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.1",
    "fflate": "^0.8.2",
    "ical.js": "^2.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "tesseract.js": "^7.0.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.3.0"
  }
}
